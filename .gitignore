
# kagami runtime state — only scopes.override.toml is source
.kagami/history.db*
.kagami/scopes.toml
.kagami/tmp/
# Secrets — env files and every backup of them never belong in git.
# A backup is git history, not a copy next to the file.
.env
.env.*
*.env
*.env.bak*
*.env.back*
!.env.example
!.env.template
!.env.sample
!.env.dist
!*.env.example
!*.env.template
